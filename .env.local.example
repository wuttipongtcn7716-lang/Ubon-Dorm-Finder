# CARTO Basemap API Key (สำหรับใช้งาน CARTO Voyager Basemaps)
# สามารถรับ Key ได้ที่ https://carto.com/
NEXT_PUBLIC_CARTO_API_KEY=default_public

# Analytics Database Isolation Configuration
# กำหนด Path สำหรับฐานข้อมูล Analytics แยกตาม Environment:
# - Development / Test: data/analytics.dev.db (ค่าเริ่มต้น)
# - Production: data/analytics.prod.db หรือ /tmp/analytics.prod.db (บน Vercel)
ANALYTICS_DB_PATH=data/analytics.dev.db

# Admin Authentication & Analytics Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_session_secret_key_here
